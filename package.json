{
  "name": "ledger-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "check": "pnpm lint && pnpm typecheck && vitest run",
    "package": "pnpm build && pnpm --filter ledger-vscode exec vsce package --no-dependencies --allow-missing-repository --skip-license -o ledger.vsix",
    "test:vscode": "pnpm build && node packages/vscode/test/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
